{
  "name": "winsecure-mcp",
  "version": "0.5.0",
  "description": "Windows CVE inventory MCP server: installed software against CVE sources, with a persistent ToDo list and AI effort assessments",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "winsecure-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-webui.mjs",
    "dev": "npm run build && node --watch dist/index.js",
    "start": "node dist/index.js",
    "web": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
